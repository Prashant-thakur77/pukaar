# Copy to .env for local runs. Never commit .env. Every variable is optional;
# the default is shown. In AWS the SAM template sets these per function.

# local = in-process AWS mock (moto) and threaded workflow; aws = real services
# PUKAAR_MODE=local
# PUKAAR_STAGE=dev
# PUKAAR_AWS_REGION=us-east-1
# PUKAAR_TABLE_NAME=pukaar-dev
# PUKAAR_BUCKET=pukaar-dev-local
# PUKAAR_STATE_MACHINE_ARN=
# PUKAAR_WORKER_FUNCTION=

# Bedrock (Strands agents). Default on in aws mode, off in local mode.
# PUKAAR_LLM_ENABLED=false
# PUKAAR_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# PUKAAR_BEDROCK_FALLBACK_REGION=us-west-2
# PUKAAR_LLM_TIMEOUT_SECONDS=20

# Speech
# PUKAAR_TRANSCRIBE_LANGUAGE=hi-IN
# PUKAAR_POLLY_VOICE=Kajal

# Approval workflow timers (SAM parameters in AWS; shorten for filming)
# PUKAAR_APPROVAL_TIMEOUT_SECONDS=600
# PUKAAR_ACK_WAIT_SECONDS=300
# PUKAAR_ALERTS_PER_VILLAGE_PER_DAY=6
# PUKAAR_REPLAY_ENABLED=true

# URLs and CORS
# PUKAAR_WEB_URL=http://localhost:5173
# PUKAAR_API_URL=http://localhost:8000
# PUKAAR_CORS_ORIGINS=http://localhost:5173

# Data
# PUKAAR_DATA_DIR=data
# PUKAAR_HYDROMET_ENABLED=true
# PUKAAR_HYDROMET_TIMEOUT_SECONDS=12

# Secrets: in AWS they live in SSM SecureString under PUKAAR_SSM_PREFIX
# (/pukaar/telegram_token, /pukaar/telegram_webhook_secret, /pukaar/link_secret).
# For a local run you may set them here instead:
# PUKAAR_SSM_PREFIX=/pukaar
# PUKAAR_TELEGRAM_TOKEN=
# PUKAAR_TELEGRAM_WEBHOOK_SECRET=
# PUKAAR_LINK_SECRET=

# Front end (frontend/.env.local)
# VITE_API_BASE=http://localhost:8000
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_USER_POOL_ID=
