# Copy to .env and fill in. Never commit .env.
# Every variable is optional. Uncomment one to override its default (shown).

# Storage (local SQLite and uploads)
# PUKAAR_DATA_DIR=backend/data
# PUKAAR_UPLOAD_DIR=backend/data/uploads
# PUKAAR_EDGE_DB_PATH=backend/data/edge.db

# Local model endpoint (OpenAI-compatible / Ollama). Replaced by Bedrock in M4.
# PUKAAR_LLM_ENABLED=true
# PUKAAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PUKAAR_LLM_MODEL=pukaar-model:2b
# PUKAAR_LLM_API_KEY=ollama
# PUKAAR_LLM_TIMEOUT_SECONDS=30
# PUKAAR_FEWSHOT_COUNT=

# Photo description through the local model
# PUKAAR_MULTIMODAL_ENABLED=true
# PUKAAR_MULTIMODAL_VERIFIER_ENABLED=false
# PUKAAR_MULTIMODAL_BASE_URL=http://127.0.0.1:11434/v1
# PUKAAR_MULTIMODAL_MODEL=pukaar-model:2b
# PUKAAR_MULTIMODAL_IMAGE_MAX_SIDE=512
# PUKAAR_MULTIMODAL_NUM_CTX=1024
# PUKAAR_MULTIMODAL_NUM_PREDICT=512
# PUKAAR_MULTIMODAL_TIMEOUT_SECONDS=300
# PUKAAR_IMAGE_ENABLED=true

# Speech to text (faster-whisper). Replaced by Amazon Transcribe in M4/M6.
# PUKAAR_ASR_ENABLED=true
# PUKAAR_ASR_MODEL_SIZE=tiny
# PUKAAR_ASR_MODEL_CACHE_DIR=backend/data/whisper-models

# Open-Meteo rain and river data
# PUKAAR_HYDROMET_ENABLED=true
# PUKAAR_HYDROMET_TIMEOUT_SECONDS=12

# Alert outputs (stub actuators) and the demo-only inject router
# PUKAAR_ACTUATORS_ENABLED=true
# PUKAAR_ENABLE_DEMO_INJECT=

# Frontend
# VITE_API_BASE=http://localhost:8000/api
