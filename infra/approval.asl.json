{
  "Comment": "Pukaar approval workflow. One Lambda dispatches on `step`. Placeholders ${...} are filled by SAM DefinitionSubstitutions; numeric values arrive as strings and are converted with States.StringToJson in Init so this file stays valid JSON.",
  "StartAt": "Init",
  "TimeoutSeconds": 7200,
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Keep alert_id/village_id/level from the execution input and load the timers.",
      "Parameters": {
        "alert_id.$": "$.alert_id",
        "village_id.$": "$.village_id",
        "level.$": "$.level",
        "officer_index": 0,
        "config": {
          "approval_timeout_seconds.$": "States.StringToJson('${ApprovalTimeoutSeconds}')",
          "ack_wait_seconds.$": "States.StringToJson('${AckWaitSeconds}')",
          "voice_retry_seconds.$": "States.StringToJson('${VoiceRetrySeconds}')"
        }
      },
      "Next": "DraftAlert"
    },
    "DraftAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "draft",
          "alert_id.$": "$.alert_id"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.draft",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "SetTimers"
    },
    "SetTimers": {
      "Type": "Pass",
      "Comment": "Each officer's window in two parts: until the nudge (and the wake-up call to an officer who has not opened the link), then the rest; and the last call's window when nobody answers. Shorter for a critical (PUKAAR_CRITICAL_APPROVAL_TIMEOUT_SECONDS).",
      "Parameters": {
        "nudge_after_seconds.$": "$.draft.result.nudge_after_seconds",
        "nudge_wait_seconds.$": "$.draft.result.nudge_wait_seconds",
        "last_call_seconds.$": "$.draft.result.last_call_seconds"
      },
      "ResultPath": "$.timers",
      "Next": "HasOfficers"
    },
    "HasOfficers": {
      "Type": "Choice",
      "Comment": "No officer to ask counts as everyone timing out.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.draft.result.officer_count",
              "IsPresent": true
            },
            {
              "Variable": "$.draft.result.officer_count",
              "NumericGreaterThan": 0
            }
          ],
          "Next": "AskOfficer"
        }
      ],
      "Default": "IsCritical"
    },
    "AskOfficer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Comment": "The handler stores task_token on the alert and notifies the officer; the API answers with SendTaskSuccess {decision, by}. The first part of the window, until the nudge ($.timers, from draft or next_officer).",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "ask_officer",
          "alert_id.$": "$.alert_id",
          "officer_index.$": "$.officer_index",
          "task_token.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.timers.nudge_after_seconds",
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "NudgeOfficer"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "RouteDecision"
    },
    "NudgeOfficer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Comment": "Night-friendly: no decision by the nudge (PUKAAR_OFFICER_WAKE_SECONDS, 3 minutes, or half a shorter window), so the same officer is reminded on Web Push and Telegram and, if they have not opened the link, phoned (the call can only send the link again; it never approves). The rest of the window follows; the first link still works.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "nudge_officer",
          "alert_id.$": "$.alert_id",
          "officer_index.$": "$.officer_index",
          "task_token.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.timers.nudge_wait_seconds",
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "MarkTimeout"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "RouteDecision"
    },
    "MarkTimeout": {
      "Type": "Pass",
      "Result": {
        "decision": "timeout"
      },
      "ResultPath": "$.approval",
      "Next": "RouteDecision"
    },
    "RouteDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.approval.decision",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.decision",
              "StringEquals": "approved"
            }
          ],
          "Next": "OutcomeDelivered"
        },
        {
          "And": [
            {
              "Variable": "$.approval.decision",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.decision",
              "StringEquals": "declined"
            }
          ],
          "Next": "OutcomeDeclined"
        },
        {
          "And": [
            {
              "Variable": "$.approval.decision",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.decision",
              "StringEquals": "timeout"
            }
          ],
          "Next": "NextOfficer"
        }
      ],
      "Default": "UnknownDecision"
    },
    "UnknownDecision": {
      "Type": "Pass",
      "Result": {
        "Error": "UnknownDecision",
        "Cause": "ask_officer callback output had no valid decision"
      },
      "ResultPath": "$.error",
      "Next": "Failsafe"
    },
    "NextOfficer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "next_officer",
          "alert_id.$": "$.alert_id",
          "officer_index.$": "$.officer_index"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.next",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "HasNextOfficer"
    },
    "HasNextOfficer": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.next.result.has_next",
              "IsPresent": true
            },
            {
              "Variable": "$.next.result.has_next",
              "BooleanEquals": true
            },
            {
              "Variable": "$.next.result.officer_index",
              "IsPresent": true
            }
          ],
          "Next": "UseNextOfficer"
        }
      ],
      "Default": "IsCritical"
    },
    "UseNextOfficer": {
      "Type": "Pass",
      "InputPath": "$.next.result.officer_index",
      "ResultPath": "$.officer_index",
      "Next": "UseNextTimers"
    },
    "UseNextTimers": {
      "Type": "Pass",
      "Comment": "The next officer's window follows the alert's level now (an alert raised to critical meanwhile gets the critical window).",
      "Parameters": {
        "nudge_after_seconds.$": "$.next.result.nudge_after_seconds",
        "nudge_wait_seconds.$": "$.next.result.nudge_wait_seconds",
        "last_call_seconds.$": "$.next.result.last_call_seconds"
      },
      "ResultPath": "$.timers",
      "Next": "AskOfficer"
    },
    "IsCritical": {
      "Type": "Choice",
      "Comment": "Prefer the level next_officer reports (it reads the stored alert); else the execution input.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.next.result.level",
              "IsPresent": true
            },
            {
              "Variable": "$.next.result.level",
              "StringEquals": "critical"
            }
          ],
          "Next": "AutoSend"
        },
        {
          "And": [
            {
              "Not": {
                "Variable": "$.next.result.level",
                "IsPresent": true
              }
            },
            {
              "Variable": "$.level",
              "IsPresent": true
            },
            {
              "Variable": "$.level",
              "StringEquals": "critical"
            }
          ],
          "Next": "AutoSend"
        }
      ],
      "Default": "LastCall"
    },
    "AutoSend": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Critical and every officer timed out: send the fixed template, status auto_sent_unapproved.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "auto_send",
          "alert_id.$": "$.alert_id"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.auto",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "AutoSendOn"
    },
    "AutoSendOn": {
      "Type": "Choice",
      "Comment": "Critical auto-send is configurable (PUKAAR_CRITICAL_AUTO_SEND; keeping it on needs DDMA sign-off). Off: nothing is delivered and the alert goes to the last call, like any other alert nobody answered.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.auto.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.auto.result.mode",
              "StringEquals": "auto"
            }
          ],
          "Next": "OutcomeAutoSent"
        }
      ],
      "Default": "LastCall"
    },
    "OutcomeAutoSent": {
      "Type": "Pass",
      "Result": "auto_sent_unapproved",
      "ResultPath": "$.outcome",
      "Next": "Deliver"
    },
    "OutcomeDelivered": {
      "Type": "Pass",
      "Result": "delivered",
      "ResultPath": "$.outcome",
      "Next": "Deliver"
    },
    "Deliver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Sends the first batch (the relays, then the one upload of the audio) and returns the other batches (delivery/dispatch.py). Everyone in one batch: the round is finished here and more is false.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "deliver",
          "alert_id.$": "$.alert_id"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.delivery",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "RunBatches"
    },
    "RunBatches": {
      "Type": "Choice",
      "Comment": "Recipients left (more than one batch, or sends put back): wait out any retry_after Telegram asked for (wait_seconds, 0 when none), then the Map sends them.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.delivery.result.more",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.more",
              "BooleanEquals": true
            }
          ],
          "Next": "WaitBeforeBatches"
        }
      ],
      "Default": "AfterDelivery"
    },
    "DeliverBatches": {
      "Type": "Map",
      "Comment": "Batches of PUKAAR_DELIVERY_BATCH_SIZE recipients (each a range of ids, read alone), 4 at once (MaxConcurrency, the same as PUKAAR_DELIVERY_CONCURRENCY: tests/test_asl.py checks); each worker takes 1/n of the Telegram rate. Every send is claimed by a conditional write first, so a retried batch never sends twice. A batch that stops is reported unfinished and sent again by the next pass.",
      "ItemsPath": "$.delivery.result.batches",
      "MaxConcurrency": 4,
      "ItemSelector": {
        "alert_id.$": "$.alert_id",
        "item.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "DeliverBatch",
        "States": {
          "DeliverBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${WorkflowFunctionArn}",
              "Payload": {
                "step": "deliver_batch",
                "alert_id.$": "$.alert_id",
                "batch.$": "$.item.batch",
                "first.$": "$.item.first",
                "last.$": "$.item.last",
                "mode.$": "$.item.mode",
                "share.$": "$.item.share"
              }
            },
            "ResultSelector": {
              "spec.$": "$.Payload.spec",
              "sent.$": "$.Payload.sent",
              "failed.$": "$.Payload.failed",
              "deferred.$": "$.Payload.deferred",
              "retry_after.$": "$.Payload.retry_after"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "BatchUnfinished"
              }
            ],
            "End": true
          },
          "BatchUnfinished": {
            "Type": "Pass",
            "Comment": "Never fails the whole delivery: deliver_done runs this batch again.",
            "Parameters": {
              "spec.$": "$.item",
              "unfinished": true
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.batch_results",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "DeliveryBroken"
        }
      ],
      "Next": "DeliverDone"
    },
    "DeliverDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Batches with sends still queued (a Telegram 429, out of time) or that stopped go round again after wait_seconds, at most PUKAAR_DELIVERY_MAX_PASSES passes; then the round is finished and recorded.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "deliver_done",
          "alert_id.$": "$.alert_id",
          "mode.$": "$.delivery.result.mode",
          "pass.$": "$.delivery.result.pass",
          "counts.$": "$.delivery.result.counts",
          "results.$": "$.batch_results"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.delivery",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "DeliveryBroken"
        }
      ],
      "Next": "RunBatches"
    },
    "WaitBeforeBatches": {
      "Type": "Wait",
      "Comment": "The longest retry_after Telegram asked for (0 to 60 s).",
      "SecondsPath": "$.delivery.result.wait_seconds",
      "Next": "DeliverBatches"
    },
    "AfterDelivery": {
      "Type": "Choice",
      "Comment": "Where a finished round goes: the first delivery waits for acknowledgements; a recall loops for voice or closes; the failsafe closes.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.delivery.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "StringEquals": "deliver"
            }
          ],
          "Next": "WaitForAcks"
        },
        {
          "And": [
            {
              "Variable": "$.delivery.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "StringEquals": "recall"
            },
            {
              "Variable": "$.delivery.result.again",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.again",
              "BooleanEquals": true
            }
          ],
          "Next": "WaitBeforeRecall"
        },
        {
          "And": [
            {
              "Variable": "$.delivery.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "StringEquals": "recall"
            }
          ],
          "Next": "Close"
        }
      ],
      "Default": "OutcomeFailsafe"
    },
    "DeliveryBroken": {
      "Type": "Choice",
      "Comment": "A delivery that broke goes to the failsafe, except the failsafe's own delivery, which closes (no loop).",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.delivery.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "StringEquals": "failsafe"
            }
          ],
          "Next": "OutcomeFailsafe"
        }
      ],
      "Default": "Failsafe"
    },
    "WaitForAcks": {
      "Type": "Wait",
      "SecondsPath": "$.config.ack_wait_seconds",
      "Next": "Recall"
    },
    "Recall": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Re-sends to people without an acknowledgement (Telegram once, voice up to PUKAAR_VOICE_MAX_ATTEMPTS), batched like the first delivery; again=true asks for another voice round after VoiceRetrySeconds.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "recall",
          "alert_id.$": "$.alert_id"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.delivery",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "RunBatches"
    },
    "WaitBeforeRecall": {
      "Type": "Wait",
      "SecondsPath": "$.config.voice_retry_seconds",
      "Next": "Recall"
    },
    "OutcomeDeclined": {
      "Type": "Pass",
      "Result": "declined",
      "ResultPath": "$.outcome",
      "Next": "Close"
    },
    "LastCall": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Comment": "Nobody in the chain answered (a Watch or Warning, or a Critical with auto-send off). The handler emits AlertUnanswered (alarmed), stores the task token, tells every officer on duty for the district and the ADM or DM on Telegram and Web Push that nothing was sent, each with a fresh one-tap link, and phones the ADM or DM (not possible with voice off, and said so). Any of them may approve or decline for one more window ($.timers.last_call_seconds); then the alert expires.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "unanswered",
          "alert_id.$": "$.alert_id",
          "task_token.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.timers.last_call_seconds",
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "Expire"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "RouteDecision"
    },
    "Expire": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "The last call passed with no decision: close as expired; nothing was sent. Every officer on duty and the ADM or DM were told at LastCall; the sweep asks again after the level's cooldown while the level holds.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "expire",
          "alert_id.$": "$.alert_id"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.expire",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failsafe"
        }
      ],
      "Next": "OutcomeExpired"
    },
    "OutcomeExpired": {
      "Type": "Pass",
      "Result": "expired",
      "ResultPath": "$.outcome",
      "Next": "Close"
    },
    "Failsafe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Any failure: the fixed template to all recipients (critical or approved; the first batch here, the rest in the Map), notify all officers, status failsafe. Not caught: if this fails the execution fails and the ExecutionsFailed alarm fires.",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "failsafe",
          "alert_id.$": "$.alert_id",
          "error.$": "$.error"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.delivery",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "FailsafeBatches"
    },
    "FailsafeBatches": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.delivery.result.more",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.more",
              "BooleanEquals": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.delivery.result.mode",
              "StringEquals": "failsafe"
            }
          ],
          "Next": "WaitBeforeBatches"
        }
      ],
      "Default": "OutcomeFailsafe"
    },
    "OutcomeFailsafe": {
      "Type": "Pass",
      "Result": "failsafe",
      "ResultPath": "$.outcome",
      "Next": "Close"
    },
    "Close": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Update the incident, clear the GSI attributes. Not caught: a failure here fails the execution (alarmed).",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "step": "close",
          "alert_id.$": "$.alert_id",
          "outcome.$": "$.outcome"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.close",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
